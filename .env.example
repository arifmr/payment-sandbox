APP_ENV=development
HTTP_PORT=8080

DATABASE_URL=postgres://postgres:postgres@localhost:5432/payment_sandbox?sslmode=disable

# Host ports published by docker-compose.yml. Only set these if the defaults are already
# taken on your machine. Container ports never change, so DATABASE_URL above only needs
# to match POSTGRES_HOST_PORT when you run the app from the host (go run ./cmd/api).
# Running the app in Docker instead, compose overrides DATABASE_URL to reach Postgres
# over the compose network, where the host is `postgres` and the port is 5432.
# POSTGRES_HOST_PORT=5432
# API_HOST_PORT=8080
# WEB_HOST_PORT=3000

JWT_SECRET=replace-me-with-a-long-random-string-32+chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

BCRYPT_COST=12

INVOICE_EXPIRY_CHECK_INTERVAL=1m

# Rate limiting on the auth endpoints. Set a rate to 0 to disable that dimension.
# Per-IP stops one host trying many accounts; per-email stops a distributed
# attempt on a single account. Both are needed.
AUTH_RATE_LIMIT_PER_MINUTE=30
AUTH_RATE_LIMIT_BURST=10
LOGIN_RATE_LIMIT_PER_MINUTE=5
LOGIN_RATE_LIMIT_BURST=5

# Publish /metrics (Prometheus text format). Keep this off on anything
# internet-facing: restrict it to the scraper via network policy or a separate port.
METRICS_ENABLED=false

# Optional: seed an admin user on first boot
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
