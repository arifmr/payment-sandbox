# Base URL for the API. Left empty in development so requests go to /api/v1 on the
# Vite dev server, which proxies them to the Go backend (see vite.config.ts) — same
# origin, so no CORS setup is needed anywhere.
#
# Set this only when the frontend is served from a different origin than the API.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api to.
VITE_API_TARGET=http://localhost:8080
