{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vitest/globals", "@testing-library/jest-dom"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "noEmit": true,

    // No "baseUrl": it is deprecated in TS 5.9 and removed in 7.0. `paths` values that
    // start with "./" are resolved relative to this file, so baseUrl was redundant here.
    // Runtime resolution is separate — the matching alias lives in vite.config.ts.
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
